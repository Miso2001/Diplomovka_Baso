function main_measurement()
    clc;
    clear;

    start_wavelength = 1500; [cite: 1, 2]
    stop_wavelength = 1550.0; [cite: 3]
    sample_points = 10001;              
    resolution = 0.07; [cite: 4]
    video_bandwith = 1000;              
    reference_level = -20; [cite: 5]
    log_scale_div = 5;                  
    sweep_average_count = 20; [cite: 6]
    storage_mode = 'OFF';               
    active_trace = 'A';                 
    trace_type = 'WRITE'; [cite: 7, 8]

    span = stop_wavelength - start_wavelength;

    instrument_OSA = visadev("GPIB0::1::INSTR"); [cite: 9]
    instrument_OSA.Timeout = 1000;
    idn_OSA = writeread(instrument_OSA, "*IDN?"); [cite: 9]
    disp(['OSA pripojená: ', idn_OSA]); [cite: 10]

    instrument_OSICS = visadev("GPIB0::20::INSTR"); [cite: 10]
    instrument_OSICS.Timeout = 20;
    idn_OSICS = writeread(instrument_OSICS, "*IDN?");

    osa_set_wavelength_range(instrument_OSA, start_wavelength, stop_wavelength);  [cite: 11]
    osa_set_sample_points(instrument_OSA, sample_points);  
    osa_set_resolution(instrument_OSA, resolution); 
    osa_set_video_bandwith(instrument_OSA, video_bandwith);
    osa_set_ref_level(instrument_OSA, reference_level);
    osa_set_scale_div(instrument_OSA, log_scale_div); [cite: 11]
    osa_set_sweep_average_count(instrument_OSA, sweep_average_count); [cite: 12]
    osa_select_storage_mode(instrument_OSA, active_trace, storage_mode);
    osa_trace_select(instrument_OSA, active_trace);
    osa_set_trace_type(instrument_OSA, active_trace, trace_type); [cite: 12]

    tic
    if strcmp(storage_mode, 'OFF')
        osa_start_measurement(instrument_OSA); [cite: 13]
    end
    if strcmp(storage_mode, 'AVS')
        osa_start_measurement_with_sweep_averaging(instrument_OSA); [cite: 14]
    end
    toc

    y_data = osa_get_trace_data(instrument_OSA, active_trace); [cite: 15]
    x_data = start_wavelength:(span/(sample_points-1)):stop_wavelength; [cite: 15]

    mask = y_data > -60;
    if any(mask)
        x_filtered = x_data(mask);
        y_filtered = y_data(mask);
        weights = y_filtered - min(y_filtered); 
        centroid_x = sum(x_filtered .* weights) / sum(weights);
        centroid_y = max(y_filtered);
        
        fprintf('\n--- ANALÝZA MAXIMA ---\n');
        fprintf('Centroid X (vlnová dĺžka): %.6f nm\n', centroid_x);
        fprintf('Maximum Y (výkon): %.3f dBm\n', centroid_y);
        fprintf('----------------------\n\n');
    end

    timestamp = datestr(now, 'yyyymmdd_HHMMSS'); [cite: 16]
    settings_filename = ['OSA_Settings_', timestamp, '.txt']; [cite: 16]
    data_filename = ['Measurement_data_', timestamp, '.csv']; [cite: 17]

    save_osa_settings(settings_filename, start_wavelength, stop_wavelength, resolution, reference_level, sweep_average_count); [cite: 17]
    save_measurement_data(data_filename, x_data, y_data); [cite: 18]
        
    p = plot(x_data, y_data, 'LineWidth', 1); [cite: 18]
    row = dataTipTextRow('Vlnová dĺžka','%{+.3f} nm'); [cite: 18]
    p.DataTipTemplate.DataTipRows(1) = row;
    p.DataTipTemplate.DataTipRows(2).Format = '%{+.3f} dBm'; [cite: 19]
    xlabel('vlnova dlzka [nm]')
    ylabel('vykon [dBm]')
    title(['Súbor: ', data_filename], 'Interpreter', 'none'); [cite: 19]
end 

function [] = osa_set_wavelength_range(instrument, start_wl, stop_wl) [cite: 20]
    if start_wl >= stop_wl
        disp("ERROR: START WL >= STOP WL"); [cite: 20]
        return [cite: 21]
    end
    actual_start_wl_str = writeread(instrument, 'STA?');   
    actual_stop_wl_str = writeread(instrument, 'STO?');   
    actual_stop_wl = sscanf(actual_stop_wl_str, '%f'); [cite: 21]
    if start_wl >= actual_stop_wl
        writeline(instrument, append('STO ', num2str(stop_wl))); [cite: 22]
        writeread(instrument, '*OPC?');
        writeline(instrument, append('STA ', num2str(start_wl))); [cite: 23]
        writeread(instrument, '*OPC?');
    else
        writeline(instrument, append('STA ', num2str(start_wl))); [cite: 23]
        writeread(instrument, '*OPC?');
        writeline(instrument, append('STO ', num2str(stop_wl))); [cite: 24]
        writeread(instrument, '*OPC?');
    end
    disp(['OSA Wavelength Range set to: ', num2str(start_wl), 'nm - ', num2str(stop_wl), 'nm']); [cite: 24]
end [cite: 25]

