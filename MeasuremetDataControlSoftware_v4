function [] = osa_start_measurement(instrument) [cite: 38]
    disp("start measurement...please wait");
    writeline(instrument,'SSI');            
    writeread(instrument,'*OPC?');
    disp("measurement finished."); [cite: 38]
end [cite: 39]

function y_data = osa_get_trace_data(instrument,trace) [cite: 39]
    instrument.flush();                      
    writeline(instrument, append('DB',trace,'?'));           
    y_data = readbinblock(instrument,"double");
    writeread(instrument,'*OPC?'); [cite: 39]
end [cite: 40]

function [] = save_osa_settings(logfile_name, start_wl, stop_wl, resolution, ref_level, sweep_avg_count) [cite: 40]
    fileID = fopen(logfile_name, 'w'); [cite: 40]
    if fileID == -1 [cite: 41]
        error('Nepodarilo sa otvoriť súbor %s', logfile_name); [cite: 41]
    end [cite: 42]
    fprintf(fileID, '--- OSA Configuration Settings ---\n');
    fprintf(fileID, 'Date and Time: %s\n\n', datestr(now)); [cite: 42]
    fprintf(fileID, 'Start Wavelength [nm]: %f\n', start_wl); [cite: 43]
    fprintf(fileID, 'Stop Wavelength [nm]: %f\n', stop_wl);
    fprintf(fileID, 'Resolution [nm]: %f\n', resolution); [cite: 43]
    fprintf(fileID, 'Reference Level [dBm]: %f\n', ref_level); [cite: 44]
    fprintf(fileID, 'Sweep Average Count: %d\n', sweep_avg_count); 
    fclose(fileID); [cite: 44]
    disp(['Nastavenia uložené do: ', logfile_name]); [cite: 45]
end [cite: 45]

function [] = save_measurement_data(filename, x_data, y_data) [cite: 45]
    fileID = fopen(filename, 'w'); [cite: 45]
    if fileID == -1 [cite: 46]
        error('Nepodarilo sa otvoriť súbor %s', filename); [cite: 46]
    end [cite: 47]
    fprintf(fileID, 'Wavelength [nm],Power [dBm]\n');
    if length(x_data) ~= length(y_data)
        error('Polia vlnovej dĺžky a výkonu nemajú rovnakú dĺžku.'); [cite: 47]
    end [cite: 48]
    data_matrix = [x_data(:), y_data(:)]'; 
    fprintf(fileID, '%6.6f,%6.6f\n', data_matrix); [cite: 48]
    fclose(fileID);
    disp(['Namerané dáta uložené do: ', filename]);
end
