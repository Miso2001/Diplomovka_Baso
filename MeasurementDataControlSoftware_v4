function main_measurement()
    clc;
    clear;
%-------------------------- PARAMETERS OF OSA --------------------------------
    start_wavelength = 1531.5;    % [nm] Rozsah: <600..1750> nm
    stop_wavelength = 1532.5;     % [nm] Rozsah: <600..1750> nm
    sample_points = 251;         % Počet bodov  51, 101, 251, 501, 1001, 2001, 5001, 10001, 20001, 50001    
    resolution = 0.07;            % 0.03|0.05|0.07|0.1|0.2|0.5|1.0 [nm]
    video_bandwith = 100;         % 10|100|200|1000|2000|10000|100000|1000000 [Hz]    
    reference_level = -20;        % Reference level  –90.0 to 30.0 [dBm]
    log_scale_div = 5;            % vertical scale division [dB/div] <0.1...10>     
    sweep_average_count = 1;      % 1 to 1000
    storage_mode = 'OFF';         % Režim ukladania: AVS | OFF     
    active_trace = 'A';           % A to J      
    trace_type = 'WRITE';         % WRITE|CALC|FIX 

    span = stop_wavelength - start_wavelength;

%-------------------------- COMMUNICATION WITH OSA -----------------------------
    instrument_OSA = visadev("GPIB0::1::INSTR");
    instrument_OSA.Timeout = 1000;
    idn_OSA = writeread(instrument_OSA, "*IDN?");
    disp(['OSA pripojená: ', idn_OSA]);

    instrument_OSICS = visadev("GPIB0::20::INSTR");
    instrument_OSICS.Timeout = 20;
    idn_OSICS = writeread(instrument_OSICS, "*IDN?");

%-------------------------- INIT OSA --------------------------------------
    osa_set_wavelength_range(instrument_OSA, start_wavelength, stop_wavelength); 
    osa_set_sample_points(instrument_OSA, sample_points);  
    osa_set_resolution(instrument_OSA, resolution); 
    osa_set_video_bandwith(instrument_OSA, video_bandwith);
    osa_set_ref_level(instrument_OSA, reference_level);
    osa_set_scale_div(instrument_OSA, log_scale_div);
    osa_set_sweep_average_count(instrument_OSA, sweep_average_count);
    osa_select_storage_mode(instrument_OSA, active_trace, storage_mode);
    osa_trace_select(instrument_OSA, active_trace);
    osa_set_trace_type(instrument_OSA, active_trace, trace_type);

%-------------------------- MEASUREMENT --------------------------------------
    tic
    if strcmp(storage_mode, 'OFF')
        osa_start_measurement(instrument_OSA);
    end
    if strcmp(storage_mode, 'AVS')
        osa_start_measurement_with_sweep_averaging(instrument_OSA);
    end
    toc

    y_data = osa_get_trace_data(instrument_OSA, active_trace);
    x_data = start_wavelength:(span/(sample_points-1)):stop_wavelength;

% --- FILTROVANIE DÁT ---
mask = y_data > -60;
    if any(mask)
        x_filtered = x_data(mask);
        y_filtered = y_data(mask);
        weights = y_filtered - min(y_filtered); 
        centroid_x = sum(x_filtered .* weights) / sum(weights); % Aktuálna vlnová dĺžka lambda_act
        centroid_y = max(y_filtered);
        
        % --- KONŠTANTY PRE VÝPOČET TEPLOTY--- 
        % (Sonda S/N: 115428/0001) 
        S1 = 6.008789e-06;
        S2 = 9.059222e-09;
        lambda_Tref = 1532.196; % [nm]

        % (Sonda S/N: 115427/0001)
        %S1 = 5.969324E-6;
        %S2 = 9.096922E-9;
        %lambda_Tref = 1539.13;

        term1 = 22.5;
        term2 = S1 / (2 * S2);
        term3 = sqrt((S1 / (2 * S2))^2 + (1 / S2) * log(centroid_x / lambda_Tref));
        
        teplota_C = term1 - term2 + term3;

        % --- VÝPIS DO TERMINÁLU ---
        fprintf('\n--- ANALÝZA MAXIMA A TEPLOTY ---\n');
        fprintf('Sonda S/N: 115428 (Konštanty: S1=%.6e, S2=%.6e, L_ref=%.3f nm)\n', S1, S2, lambda_Tref);
        fprintf('Centroid X (vlnová dĺžka): %.4f nm\n', centroid_x);
        fprintf('Maximum Y (výkon): %.3f dBm\n', centroid_y);
        fprintf('Vypočítaná teplota: %.2f °C\n', teplota_C);
        fprintf('--------------------------------\n\n');
    end

% --- DYNAMICKÉ NÁZVY SÚBOROV ---
    timestamp = datestr(now, 'yyyymmdd_HHMMSS');
    settings_filename = ['OSA_Settings_', timestamp, '.txt'];
    data_filename = ['Measurement_data_', timestamp, '.csv'];

% --- UKLADANIE DÁT ---
    save_osa_settings(settings_filename, start_wavelength, stop_wavelength,sample_points, resolution, video_bandwith, reference_level, sweep_average_count);
    save_measurement_data(data_filename, x_data, y_data);
        
    p = plot(x_data, y_data, 'LineWidth', 1);
    xlabel('vlnova dlzka [nm]')
    ylabel('vykon [dBm]')
    title(['Súbor: ', data_filename], 'Interpreter', 'none');
end 

%-------------------------- OSA CONTROL FUNCTIONS --------------------------------
function [] = osa_set_wavelength_range(instrument, start_wl, stop_wl)
    if start_wl >= stop_wl
        disp("ERROR: START WL >= STOP WL");
        return
    end
    actual_start_wl_str = writeread(instrument, 'STA?');   
    actual_stop_wl_str = writeread(instrument, 'STO?');   
    actual_stop_wl = sscanf(actual_stop_wl_str, '%f');
    if start_wl >= actual_stop_wl
        writeline(instrument, append('STO ', num2str(stop_wl)));
        writeread(instrument, '*OPC?');
        writeline(instrument, append('STA ', num2str(start_wl)));
        writeread(instrument, '*OPC?');
    else
        writeline(instrument, append('STA ', num2str(start_wl)));
        writeread(instrument, '*OPC?');
        writeline(instrument, append('STO ', num2str(stop_wl)));
        writeread(instrument, '*OPC?');
    end
    disp(['OSA Wavelength Range set to: ', num2str(start_wl), 'nm - ', num2str(stop_wl), 'nm']);
end

function [] = osa_set_sample_points(instrument, sample_points)
    writeline(instrument, append('MPT ', int2str(sample_points)));
    writeread(instrument, '*OPC?');
end

function [] = osa_set_resolution(instrument, resolution)
    writeline(instrument, append('RES ', num2str(resolution)));
    writeread(instrument, '*OPC?');
end

function [] = osa_set_video_bandwith(instrument, bandwith)
    writeline(instrument, append('VBW ', int2str(bandwith)));          
    writeread(instrument, '*OPC?');
    disp(['OSA Video Bandwidth set to: ', int2str(bandwith), ' Hz']);
end

function [] = osa_set_ref_level(instrument, ref_level)
    writeline(instrument, append('RLV ', num2str(ref_level)));
    writeread(instrument, '*OPC?');
    disp(['OSA Reference Level set to: ', num2str(ref_level), ' dBm']);
end

function [] = osa_set_scale_div(instrument, scalediv)
    writeline(instrument, append('LOG ', num2str(scalediv)));         
    writeread(instrument, '*OPC?');
    disp(['OSA Log Scale Division set to: ', num2str(scalediv), ' dB/div']);
end

function [] = osa_set_sweep_average_count(instrument, count)
    writeline(instrument, append('AVS ', int2str(count)));         
    writeread(instrument, '*OPC?');
    disp(['OSA Sweep Average Count set to: ', int2str(count)]);
end

function [] = osa_select_storage_mode(instrument, active_trace, storage_mode)
    writeline(instrument, append('SMD ', active_trace, ',', storage_mode));
    writeread(instrument, '*OPC?');
    disp(['OSA Trace ', active_trace, ' Storage Mode set to: ', storage_mode]);
end

function [] = osa_trace_select(instrument, trace)
    writeline(instrument, append('TSL ', trace));     
    writeread(instrument, '*OPC?');
    disp(['OSA Active Trace set to: ', trace]);
end

function [] = osa_set_trace_type(instrument, trace, trace_type)
    writeline(instrument, append('TTP ', trace, ',', trace_type));
    writeread(instrument, '*OPC?');
    disp(['OSA Trace ', trace, ' Type set to: ', trace_type]);
end

function [] = osa_start_measurement(instrument)
    disp("start measurement...please wait");
    writeline(instrument,'SSI');            
    writeread(instrument,'*OPC?');
    disp("measurement finished.");
end

function y_data = osa_get_trace_data(instrument,trace)
    instrument.flush();                      
    writeline(instrument, append('DB',trace,'?'));           
    y_data = readbinblock(instrument,"double");
    writeread(instrument,'*OPC?');
end

%--------------------------------- SAVING DATA -----------------------------------
function [] = save_osa_settings(logfile_name, start_wl, stop_wl,sample_points, resolution,video_bandwith, ref_level, sweep_avg_count)
    fileID = fopen(logfile_name, 'w');
    if fileID == -1
        error('Nepodarilo sa otvoriť súbor %s', logfile_name);
    end
    fprintf(fileID, '--- OSA Configuration Settings ---\n');
    fprintf(fileID, 'Date and Time: %s\n\n', datestr(now));
    fprintf(fileID, 'Start Wavelength [nm]: %4.2f\n', start_wl);
    fprintf(fileID, 'Stop Wavelength [nm]: %4.2f\n', stop_wl);
    fprintf(fileID, 'Sample points: %.0f\n', sample_points);
    fprintf(fileID, 'Resolution [nm]: %.2f\n', resolution);
    fprintf(fileID, 'Video bandwidth [Hz]: %.0f\n', video_bandwith);
    fprintf(fileID, 'Reference Level [dBm]: %.2f\n', ref_level);
    fprintf(fileID, 'Sweep Average Count: %d\n', sweep_avg_count); 
    fclose(fileID);
    disp(['Nastavenia uložené do: ', logfile_name]);
end

function [] = save_measurement_data(filename, x_data, y_data)
    fileID = fopen(filename, 'w');
    if fileID == -1
        error('Nepodarilo sa otvoriť súbor %s', filename);
    end
    fprintf(fileID, 'Wavelength [nm],Power [dBm]\n');
    if length(x_data) ~= length(y_data)
        error('Polia vlnovej dĺžky a výkonu nemajú rovnakú dĺžku.');
    end
    data_matrix = [x_data(:), y_data(:)]'; 
    fprintf(fileID, '%6.6f,%6.6f\n', data_matrix);
    fclose(fileID);
    disp(['Namerané dáta uložené do: ', filename]);
end
